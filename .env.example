# TELEGRAM_BOT_TOKEN: Токен бота от @BotFather в Telegram.
TELEGRAM_BOT_TOKEN=""

# TELEGRAM_CHAT_ID: ID вашего чата или канала (необязательно, можно просто написать боту /start).
TELEGRAM_CHAT_ID=""

# APP_URL: Публичный HTTPS-адрес приложения на Render (для кнопки открытия Mini App в боте).
APP_URL=""

# Необязательные бесплатные нейросети (по желанию — для ёмкой выжимки главных новостей в Telegram):
# GROQ_API_KEY: Бесплатный API ключ от console.groq.com (Llama 3.3 70B, 0 МБ нагрузки на RAM Render).
GROQ_API_KEY=""
# GEMINI_API_KEY: Бесплатный API ключ от Google AI Studio.
GEMINI_API_KEY=""
